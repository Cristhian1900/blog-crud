# Variables de entorno - Copia esto a .env y configura tus valores

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=blog_crud

# Sesión
SESSION_SECRET=mi_secreto_super_seguro_cambia_esto

# Cloudinary (para producción en Railway)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Entorno
NODE_ENV=development
PORT=3000

# Admin por defecto (se crea automáticamente si no existe)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
