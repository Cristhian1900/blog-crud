<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editar Blog | BlogsCRUD</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container mt-3">
  <%- include('../partials/flash') %>
</div>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="form-card">
        <div class="form-card-header form-card-header--edit">
          <div class="form-card-icon"><i class="bi bi-pencil-square"></i></div>
          <h1 class="form-card-title">Editar Blog</h1>
          <p class="form-card-subtitle">ID: #<%= blog.id_blog %></p>
        </div>

        <div class="form-card-body">
          <!-- Errores de validación -->
          <% if (locals.errors && errors.length > 0) { %>
            <div class="alert alert-danger mb-4">
              <ul class="mb-0">
                <% errors.forEach(e => { %>
                  <li><i class="bi bi-exclamation-circle me-2"></i><%= e %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <form action="/admin/blogs/<%= blog.id_blog %>?_method=PUT" method="POST" enctype="multipart/form-data" id="blogForm" novalidate>

            <!-- Título -->
            <div class="mb-4">
              <label for="titulo" class="form-label">Título <span class="text-danger">*</span></label>
              <div class="input-group-custom">
                <i class="bi bi-type-h1 input-icon"></i>
                <input
                  type="text"
                  id="titulo"
                  name="titulo"
                  class="form-control form-control-custom"
                  value="<%= blog.titulo %>"
                  required
                  minlength="3"
                  maxlength="255"
                />
              </div>
            </div>

            <!-- Autor -->
            <div class="mb-4">
              <label for="autor" class="form-label">Autor</label>
              <div class="input-group-custom">
                <i class="bi bi-person input-icon"></i>
                <input
                  type="text"
                  id="autor"
                  name="autor"
                  class="form-control form-control-custom"
                  value="<%= blog.autor %>"
                  maxlength="100"
                />
              </div>
            </div>

            <!-- Contenido -->
            <div class="mb-4">
              <label for="contenido" class="form-label">Contenido <span class="text-danger">*</span></label>
              <div class="input-group-custom">
                <i class="bi bi-text-paragraph input-icon input-icon-top"></i>
                <textarea
                  id="contenido"
                  name="contenido"
                  class="form-control form-control-custom"
                  rows="8"
                  required
                  minlength="10"
                  maxlength="10000"
                ><%= blog.contenido %></textarea>
              </div>
              <div class="form-hint"><span id="charCount">0</span> / 10,000 caracteres</div>
            </div>

            <!-- Imagen actual -->
            <% if (blog.imagen) { %>
              <div class="mb-3">
                <label class="form-label">Imagen actual</label>
                <div class="current-image-preview">
                  <img src="<%= blog.imagen %>" alt="Imagen actual" class="current-img" />
                  <p class="current-img-hint"><i class="bi bi-info-circle me-1"></i>Sube una nueva imagen para reemplazarla</p>
                </div>
              </div>
            <% } %>

            <!-- Nueva imagen -->
            <div class="mb-4">
              <label for="imagen" class="form-label">
                <%= blog.imagen ? 'Nueva imagen (opcional)' : 'Imagen destacada' %>
              </label>
              <div class="upload-zone" id="uploadZone">
                <input
                  type="file"
                  id="imagen"
                  name="imagen"
                  class="upload-input"
                  accept="image/jpeg,image/jpg,image/png,image/gif,image/webp"
                />
                <div class="upload-content" id="uploadContent">
                  <i class="bi bi-cloud-arrow-up upload-icon"></i>
                  <p class="upload-text">Arrastra tu imagen aquí o <span class="upload-link">haz clic para seleccionar</span></p>
                  <p class="upload-hint">JPG, PNG, GIF, WebP — Máx. 5MB</p>
                </div>
                <div class="upload-preview" id="uploadPreview" style="display:none;">
                  <img id="previewImg" src="" alt="Preview" class="preview-img" />
                  <button type="button" class="preview-remove" id="removeImg">
                    <i class="bi bi-x-circle-fill"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- Acciones -->
            <div class="d-flex gap-3 pt-2">
              <button type="submit" class="btn btn-warning-custom btn-lg flex-grow-1">
                <i class="bi bi-save-fill me-2"></i>Guardar cambios
              </button>
              <a href="/blogs/<%= blog.id_blog %>" class="btn btn-cancel btn-lg">
                <i class="bi bi-x-lg me-2"></i>Cancelar
              </a>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
