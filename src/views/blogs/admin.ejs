<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel Admin — Blogs | BlogsCRUD</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container mt-3">
  <%- include('../partials/flash') %>
</div>

<main class="container py-5">

  <!-- Admin Header -->
  <div class="admin-header d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
    <div>
      <h1 class="admin-title"><i class="bi bi-shield-check me-3"></i>Panel de Administración</h1>
      <p class="admin-subtitle">Gestiona todos los blogs del sistema</p>
    </div>
    <a href="/admin/blogs/create" class="btn btn-primary-custom btn-lg">
      <i class="bi bi-plus-circle-fill me-2"></i>Nuevo Blog
    </a>
  </div>

  <!-- Stats Bar -->
  <div class="row g-4 mb-5">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon stat-icon--primary"><i class="bi bi-journal-richtext"></i></div>
        <div class="stat-value"><%= blogs.length %></div>
        <div class="stat-label">Total Blogs</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon stat-icon--success"><i class="bi bi-chat-fill"></i></div>
        <div class="stat-value"><%= blogs.reduce((s, b) => s + parseInt(b.total_comentarios || 0), 0) %></div>
        <div class="stat-label">Comentarios</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon stat-icon--warning"><i class="bi bi-image-fill"></i></div>
        <div class="stat-value"><%= blogs.filter(b => b.imagen).length %></div>
        <div class="stat-label">Con imagen</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon stat-icon--info"><i class="bi bi-people-fill"></i></div>
        <div class="stat-value"><%= [...new Set(blogs.map(b => b.autor))].length %></div>
        <div class="stat-label">Autores</div>
      </div>
    </div>
  </div>

  <!-- Blogs Table -->
  <% if (blogs.length === 0) { %>
    <div class="empty-state text-center py-5">
      <div class="empty-icon mb-4"><i class="bi bi-journal-x"></i></div>
      <h3 class="empty-title">No hay blogs todavía</h3>
      <a href="/admin/blogs/create" class="btn btn-primary-custom mt-3">
        <i class="bi bi-plus me-2"></i>Crear el primer blog
      </a>
    </div>
  <% } else { %>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Imagen</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Comentarios</th>
            <th>Fecha</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% blogs.forEach(blog => { %>
            <tr>
              <td><span class="table-id">#<%= blog.id_blog %></span></td>
              <td>
                <% if (blog.imagen) { %>
                  <img src="<%= blog.imagen %>" alt="" class="table-thumb" />
                <% } else { %>
                  <div class="table-thumb-placeholder"><i class="bi bi-image"></i></div>
                <% } %>
              </td>
              <td>
                <a href="/blogs/<%= blog.id_blog %>" class="table-title-link" target="_blank">
                  <%= blog.titulo %>
                </a>
              </td>
              <td><span class="table-author"><%= blog.autor %></span></td>
              <td>
                <span class="badge-comments-table">
                  <i class="bi bi-chat-fill me-1"></i><%= blog.total_comentarios %>
                </span>
              </td>
              <td class="table-date">
                <%= new Date(blog.created_at).toLocaleDateString('es-ES', { year:'numeric', month:'short', day:'numeric' }) %>
              </td>
              <td>
                <div class="d-flex gap-2">
                  <a href="/blogs/<%= blog.id_blog %>" class="btn btn-sm btn-table-view" title="Ver">
                    <i class="bi bi-eye-fill"></i>
                  </a>
                  <a href="/admin/blogs/<%= blog.id_blog %>/edit" class="btn btn-sm btn-table-edit" title="Editar">
                    <i class="bi bi-pencil-fill"></i>
                  </a>
                  <form action="/admin/blogs/<%= blog.id_blog %>?_method=DELETE" method="POST" class="delete-form">
                    <button type="submit" class="btn btn-sm btn-table-delete" title="Eliminar">
                      <i class="bi bi-trash-fill"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</main>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
