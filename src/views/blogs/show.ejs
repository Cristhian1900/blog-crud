<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= blog.contenido.substring(0, 150) %>" />
  <title><%= blog.titulo %> | BlogsCRUD</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container mt-3">
  <%- include('../partials/flash') %>
</div>

<main>
  <!-- Blog Hero -->
  <% if (blog.imagen) { %>
    <div class="blog-hero-img-wrapper">
      <img src="<%= blog.imagen %>" alt="<%= blog.titulo %>" class="blog-hero-img" />
      <div class="blog-hero-overlay"></div>
    </div>
  <% } %>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">

        <!-- Blog Article -->
        <article class="blog-article mt-5">
          <div class="blog-article-meta mb-3">
            <a href="/" class="back-link"><i class="bi bi-arrow-left me-2"></i>Volver al inicio</a>
            <div class="d-flex align-items-center gap-3 mt-3 flex-wrap">
              <span class="meta-badge"><i class="bi bi-person-fill me-1"></i><%= blog.autor %></span>
              <span class="meta-badge"><i class="bi bi-calendar3 me-1"></i>
                <%= new Date(blog.created_at).toLocaleDateString('es-ES', { year:'numeric', month:'long', day:'numeric' }) %>
              </span>
              <span class="meta-badge"><i class="bi bi-chat-fill me-1"></i><%= comentarios.length %> comentario<%= comentarios.length !== 1 ? 's' : '' %></span>
              <% if (isAdmin) { %>
                <div class="ms-auto d-flex gap-2">
                  <a href="/admin/blogs/<%= blog.id_blog %>/edit" class="btn btn-sm btn-warning-custom">
                    <i class="bi bi-pencil-fill me-1"></i>Editar
                  </a>
                  <form action="/admin/blogs/<%= blog.id_blog %>?_method=DELETE" method="POST" class="delete-form">
                    <button type="submit" class="btn btn-sm btn-danger-custom">
                      <i class="bi bi-trash-fill me-1"></i>Eliminar
                    </button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>

          <h1 class="blog-article-title"><%= blog.titulo %></h1>

          <div class="blog-article-body">
            <%= blog.contenido %>
          </div>
        </article>

        <!-- Divider -->
        <div class="divider my-5"><span>Comentarios</span></div>

        <!-- Comments Section -->
        <section id="comentarios" class="comments-section">
          <h2 class="comments-title mb-4">
            <i class="bi bi-chat-square-text me-2"></i>
            <%= comentarios.length %> Comentario<%= comentarios.length !== 1 ? 's' : '' %>
          </h2>

          <!-- Comment Form -->
          <div class="comment-form-wrapper mb-5">
            <h3 class="comment-form-title">Deja tu comentario</h3>
            <form action="/blogs/<%= blog.id_blog %>/comentarios" method="POST">
              <div class="row g-3">
                <div class="col-md-4">
                  <label for="autor" class="form-label">Tu nombre <span class="text-muted">(opcional)</span></label>
                  <div class="input-group-custom">
                    <i class="bi bi-person input-icon"></i>
                    <input
                      type="text"
                      id="autor"
                      name="autor"
                      class="form-control form-control-custom"
                      placeholder="Anónimo"
                      maxlength="100"
                    />
                  </div>
                </div>
                <div class="col-12">
                  <label for="contenido" class="form-label">Comentario <span class="text-danger">*</span></label>
                  <div class="input-group-custom">
                    <i class="bi bi-chat-left-text input-icon input-icon-top"></i>
                    <textarea
                      id="contenido"
                      name="contenido"
                      class="form-control form-control-custom"
                      rows="4"
                      placeholder="Escribe tu comentario aquí..."
                      required
                      minlength="3"
                      maxlength="2000"
                    ></textarea>
                  </div>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-primary-custom">
                    <i class="bi bi-send-fill me-2"></i>Publicar comentario
                  </button>
                </div>
              </div>
            </form>
          </div>

          <!-- Comments List -->
          <% if (comentarios.length === 0) { %>
            <div class="no-comments text-center py-4">
              <i class="bi bi-chat-square-dots no-comments-icon"></i>
              <p class="no-comments-text">Sé el primero en comentar</p>
            </div>
          <% } else { %>
            <div class="comments-list">
              <% comentarios.forEach(c => { %>
                <div class="comment-item">
                  <div class="comment-avatar">
                    <%= c.autor.charAt(0).toUpperCase() %>
                  </div>
                  <div class="comment-content">
                    <div class="comment-header">
                      <span class="comment-author"><%= c.autor %></span>
                      <span class="comment-date">
                        <%= new Date(c.created_at).toLocaleDateString('es-ES', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %>
                      </span>
                      <% if (isAdmin) { %>
                        <form action="/admin/comentarios/<%= c.id_comentario %>?_method=DELETE" method="POST" class="ms-auto delete-comment-form">
                          <button type="submit" class="btn-comment-delete" title="Eliminar comentario">
                            <i class="bi bi-trash3-fill"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                    <p class="comment-text"><%= c.contenido %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </section>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
